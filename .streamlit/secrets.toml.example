# Salin file ini menjadi secrets.toml untuk pengembangan lokal.
# Jangan pernah commit secrets.toml ke GitHub.

[connections.dw]
url = "postgresql://dashboard_reader.PROJECT_REF:READER_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

[connections.ingest]
url = "postgresql://dashboard_ingest.PROJECT_REF:INGEST_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

[admin]
username = "admin"
password = "REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD"
